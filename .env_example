# Required for Telegram notifications
TELEGRAM_BOT_TOKEN=replace_with_your_bot_token
TELEGRAM_CHAT_ID=replace_with_your_chat_id
# 3.1 seconds stays below Telegram's 20-messages-per-minute group limit.
TELEGRAM_SEND_INTERVAL_SECONDS=3.1

# Public API for projects AND employer trust data; no access token or HTML requests.
# A full active-project URL is also accepted (e.g. with project_types[]=fixed&max_price=1500).
FREELANCER_API_URL=https://www.freelancer.com/api/projects/0.1/projects/active/
FREELANCER_PAGE_LIMIT=50
# Optional language codes, also sent together (for example: en,es,ja).
FREELANCER_LANGUAGES=

# One-time database bootstrap values. After the first startup, manage these with Telegram commands;
# changing them here will no longer affect the bot.
# Comma-separated project filters (case-insensitive). Leave either empty to disable it.
# FILTER_MATCH_MODE=any means a project may match a search word OR a skill.
# FILTER_MATCH_MODE=all means it must match at least one search word AND one skill.
SEARCH_WORDS=
SKILLS=
FILTER_MATCH_MODE=any

# One-time initial threshold. Use /set_threshold afterward.
SCORE_THRESHOLD=65

# Profile Completed uses owner_info.status.profile_complete.
# Identity, phone, and email verification are displayed but do not change the score.
# Rating is display-only. The five score maximums below add up to 65 by default.
SCORE_PAYMENT_VERIFIED=20
SCORE_DEPOSIT_MADE=15
SCORE_PROFILE_COMPLETED=5
SCORE_REVIEWS_MAX=15
SCORE_MEMBER_AGE_MAX=10

# Review score grows logarithmically and reaches its maximum at this count.
SCORE_REVIEWS_CAP=50
# Member age grows logarithmically by day and reaches its maximum at 100 days.
SCORE_MEMBER_AGE_MAX_DAYS=100

POLL_INTERVAL_SECONDS=60
STATE_DB_PATH=freelancer_monitor.db
LOG_LEVEL=INFO
