{
  "name": "freelancer-monitor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Monitor Freelancer projects and notify Telegram using owner trust scores.",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --use-system-ca --import tsx --watch --watch-preserve-output src/main.ts",
    "start": "node --use-system-ca dist/src/main.js",
    "check-config": "npm start -- --check-config",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
